+    r.use("/dispute-categories", disputeCategoryRoutes);
+
+    r.use("/stellar/fees", stellarFeesRoutes);
+    r.use("/stellar/tx", stellarTxStatusRoutes);
+    r.use("/stellar/assets", stellarAssetRoutes);
